source:"<!-- Hotjar Tracking Code for https://interbank.pe/ -->\n<script>\n    (function(h,o,t,j,a,r){\n        h.hj=h.hj||function(){(h.hj.q=h.hj.q||[]).push(arguments)};\n        h._hjSettings={hjid:331531,hjsv:5};\n        a=o.getElementsByTagName('head')[0];\n        r=o.createElement('script');r.async=1;\n        r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv;\n        a.appendChild(r);\n    })(window,document,'//static.hotjar.com/c/hotjar-','.js?sv=');\n</script>",language:"html"},timeout:2e3,delayNext:!0},{modulePath:"core/src/lib/actions/customCode.js",settings:{source:'var cookies = document.cookie.split("; ").reduce((prev, current) => {\n    const [name, ...value] = current.split("=");\n    prev[name] = value.join("=");\n    return prev;\n}, {});\n\nvar time = new Date().getTime();\nvar userAnonymous = "user" + time;\nvar userId = cookies.digital_id || userAnonymous;\nwindow.hj(\'identify\', userId, {\n    user_digital_id: userId\n});',language:"javascript"},timeout:2e3,delayNext:!0},{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"elements = document.querySelectorAll(\".a-btn-search-close\");\nelements.forEach(function(element){\n    element.addEventListener('click', function(){\n        if(this.classList.contains('is-open')){\n          _satellite.logger.log('[LOG] : event buscador');  \n          hj('event', 'buscador');\n        }\n    });\n    \n})",language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RL7bdbe2dcadda4f33a71b9dcad877223b",name:"Web SDK - Heros Offerings: Click",events:[{modulePath:"data-layer-manager-search-discovery/src/lib/events/data_layer_push_event.js",settings:{eventType:"slideClick",subscription:null},ruleOrder:50}],conditions:[],actions:[{modulePath:"adobe-alloy/dist/lib/actions/sendEvent/index.js",settings:{xdm:"%web.interaction.heroClick.merged%",type:"web.webinteraction.linkClicks",instanceName:"alloy",edgeConfigOverrides:{staging:{},production:{},development:{}}},timeout:2e3,delayNext:!0}]},{id:"RL7ed4c
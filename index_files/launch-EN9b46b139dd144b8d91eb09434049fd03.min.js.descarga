ro home v1",events:[{modulePath:"core/src/lib/events/domReady.js",settings:{},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/variable.js",settings:{name:"window.location.pathname",variableValues:[{value:"^\\/(personas)?$",valueIsRegex:!0},{value:"/1009ae9aa1aa14092f4aaf3e0fdc4f00"}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{global:!1,source:"https://assets.adobedtm.com/df637a308f4c/d9eb0acc4ee2/0b48f5f8e516/RC0d68bca850ef4bb88f25caec489ea71c-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0}]},{id:"RL5824cc781b4d4e8189c88637fa2075be",name:"Bypass Hub Cliente - Extracash",events:[{modulePath:"core/src/lib/events/domReady.js",settings:{},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"/solicitar/tarjeta/extracash/simulacion"}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{global:!1,source:"https://assets.adobedtm.com/df637a308f4c/d9eb0acc4ee2/0b48f5f8e516/RCc9ece32bfc074cd087bfcf600ea4f9c7-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0}]},{id:"RL58d4cb79392142c9b04cccc27e02e49f",name:"Productos Para Ti: Logic",events:[{modulePath:"core/src/lib/events/libraryLoaded.js",settings:{},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"equals",caseInsensitive:!0},leftOperand:"%Page Path%",rightOperand:"home"},timeout:2e3},{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"matchesRegex",caseInsensitive:!0},leftOperand:"%Digital ID%",rightOperand:".+"},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:'/*jshint esversion: 8 */\n(function () {\n\tconst ENDPOINT = "https://adobeioruntime.net/apis/26891-577sapphirecrow/recommendationsV8/list-products";\n\tconst TIMEOUT = 3000;\n\tconst DIGITAL_ID = _satellite.getVar("Digital ID");\n\tconst EXCLUDE_PRODUCTS = "ADELANTO_SUELDO";\n\n\tasync function getOffers() {\n\t\ttry {\n\t\t\tconst response = await fetchWithTimeout(_satellite.getVar(\'Productos Para Ti - Data\'), {\n\t\t\t\tcustomer_id: DIGITAL_ID,\n\t\t\t\ttracking_id: "GUID",\n\t\t\t\tnum_results: 6,\n\t\t\t\texludeProducts: EXCLUDE_PRODUCTS,\n\t\t\t});\n\t\t\treturn await response;\n\t\t} catch (error) {\n\t\t\tthrow {\n\t\t\t\tmessage: "recommendation timeout",\n\t\t\t\tis_client: false\n\t\t\t};\n\t\t}\n\t}\n\n\tasync function fetchWithTimeout(sessionData, options = {}) {\n\t\tconst controller = new AbortController();\n\t\tconst id = setTimeout(() => controller.abort(), TIMEOUT);\n\t\tif (sessionData) {\n\t\t\tclearTimeout(id);\n\t\t\treturn sessionData;\n\t\t}\n\n\t\tconst response = await fetch(ENDPOINT, {\n\t\t\tmethod: "POST",\n\t\t\tmode: "cors",\n\t\t\tcache: "no-cache",\n\t\t\tcredentials: "same-origin",\n\t\t\theaders: {\n\t\t\t\t"Content-Type": "application/json",\n\t\t\t},\n\t\t\tredirect: "follow", // manual, *follow, error\n\t\t\treferrerPolicy: "no-referrer", // no-referrer,\n\t\t\tbody: JSON.stringify(options),\n\t\t\tsignal: controller.signal,\n\t\t});\n\t\tclearTimeout(id);\n\t\treturn response.json();\n\t}\n\n\tfunction triggerTargetMbox(mboxName, parameters) {\n\t\tadobe.target.getOffer({\n\t\t\t"mbox": mboxName,\n\t\t\t"params": parameters,\n\t\t\t"success": function (offer) {\n\t\t\t\tadobe.target.applyOffer({\n\t\t\t\t\t"mbox": mboxName,\n\t\t\t\t\t"offer": offer\n\t\t\t\t});\n\t\t\t},\n\t\t\t"error": function (status, error) {\n\t\t\t\t_satellite.logger.error(\'Error\', status, error);\n\t\t\t}\n\t\t});\n\t}\n\n\tconst triggerDecisionScopes = (mboxName, parameters) => {\n        let metadata = {};\n        metadata[mboxName] = {\n            selector: "head",\n            actionType: "appendHtml"\n        };\n\t\t_satellite.track(\'triggerDecisionScopes\', {\n\t\t\tdata: {\n\t\t\t\t__adobe: {\n\t\t\t\t\ttarget: parameters\n\t\t\t\t}\n\t\t\t},\n\t\t\tdecisionScopes: [mboxName], \n            metadata: metadata\n\t\t});\n\t}\n\n\tconst pushEventToDataLayer = (eventLabel) => {\n\t\twindow.digitalData = window.digitalData || [];\n\t\twindow.digitalData.push({\n\t\t\tevent: eventLabel\n\t\t});\n\t}\n\n\tconst setVars = (dataKey, value) => {\n\t\t_satellite.ext = _satellite.ext || {};\n\t\t_satellite.ext.data = _satellite.ext.data || {};\n\t\t_satellite.ext.data[dataKey] = value;\n\t}\n\n\treturn (async function () {\n\t\tlet promise = getOffers();\n\t\tawait promise.then((data) => {\n\t\t\tsetVars(\'rtdOffers\', data);\n\t\t\t_satellite.logger.log(\'Productos Para Ti - Data: loaded\', data);\n\t\t\tlet is_client = (data.is_client ? data.is_client : false);\n\t\t\ttriggerDecisionScopes(\'activity-Productos-Para-Ti-RTD-WebSDK\', { "is_client": is_client });\n\t\t}).catch((error) => {\n\t\t\t_satellite.logger.error(`### Error: ${error.message}`);\n\t\t\tpushEventToDataLayer(error.message);\n\t\t});\n\t\treturn promise;\n\t})();\n})()',language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RL5bcb09b9dda345d5a3068362d851de5e",name:"Web SDK - All Pages ",events:[{modulePath:"core/src/lib/events/libraryLoaded.js",settings:{},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"doesNotEqual"},leftOperand:"%Hostname%",rightOperand:"plin-qr.interbank.pe"},timeout:2e3},{modulePath:"core/src/lib/conditions/pathAndQuerystring.js",settings:{paths:[{value:"\\/cuentas\\/cuentas-diversas\\/ahorro-euros",valueIsRegex:!0}]},negate:!0,timeout:2e3},{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"equals"},leftOperand:"%digital data: page name%",rightOperand:"Modal:PrimerAbono:Inicio"},negate:!0,timeout:2e3},{modulePath:"core/src/lib/conditions/valueComparison.js",settings:{comparison:{operator:"equals"},leftOperand:"%Performance Navigation%",rightOperand:0},timeout:2e3}],actions:[{modulePath:"adobe-alloy/dist/lib/actions/sendEvent/index.js",settings:{xdm:"%web.pageView.allPages.merged%",data:"%Freeform Data%",type:"web.webpagedetails.pageViews",instanceName:"alloy",personalization:{includeRenderedPropositions:!0},renderDecisions:!0},timeout:2e3,delayNext:!0},{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"    // Selecciona el elemento al que quieres cambiar el z-index\n  var overlay = document.getElementById('alloy-overlay-container');\n  var message = document.getElementById('alloy-messaging-container');\n        \n// Cambia el z-index del elemento\n  message.style.zIndex = '999999';\n  \n  if (overlay) {\n    const opacity = parseFloat(window.getComputedStyle(overlay).opacity);\n    \n    if (opacity <= 0.05) {\n      overlay.style.position = 'relative';\n    } else {\n      overlay.style.zIndex = '999999';\n    }\n  }\n",language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RL5bf981683a324e81b07153406c73a82e",name:"Audience - Promociones Inscripcion",events:[{modulePath:"core/src/lib/events/pageBottom.js",settings:{},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"^/promociones/inscripcion",valueIsRegex:!0}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"var audience = _satellite.getVar(\"audience_tracking\");\naudience(\".lh-btn-submit\",\"form [name='documento'],form [name='numeroDocumento']\");\n\n/*(function (w, d) {\n    var $doc = d.getElementById(\"ff_documentNumber\") || d.getElementById(\"dni\") || false;\n    var doctype = d.getElementById(\"ff_selectDocumentType\") || 1;\n    if (document) {\n        $doc.addEventListener(\"blur\", function (e) {\n            var $document = $doc.value;\n            var index = doctype.selectedIndex;\n            var $doctype = doctype.options[index].value;\n            var interbank = new Image();\n            interbank.src = \"https://audience.interbank.pe/track?payload=\" + $document + \"&doctype=\" + $doctype + \"&domain=.interbank.pe&auth=false\";\n            console.log('digital_id \u0669(\u033e\u25cf\u032e\u032e\u0303\u033e\u2022\u0303\u033e)\u06f6');\n        });\n    }\n})(window, document);\n\n\n// GENERIC\nHALCON.execute(function () {\n  var timer;\n  var countDown;\n  var existElem = function ($elems) { return $elems.length > 0 ? $elems : false; };\n  var counter = function() {\n    countDown = 5;\n    timer = setInterval(function () {\n      countDown -= 1;\n      if (countDown <= 0) {\n        $btn.removeClass('active')\n        $form.submit();\n        clearInterval(timer);\n      }\n    }, 1000);\n  }\n  var $form = existElem($('.lh-ff form'));\n  if (!$form) return;\n  var $btn = existElem($form.find('.lh-btn-submit'));\n  var beforeSubmit = function() {\n    counter();\n    var $inputDoc = existElem($form.find('[name=\"documento\"]')) || existElem($form.find('[name=\"numeroDocumento\"]'));\n\n \n\n    if (!$inputDoc) return;\n    var doc = $inputDoc.val();\n    if (doc.length > 7) {\n        $.ajax({\n            url: 'https://audience.interbank.pe/track?payload=' + doc + '&domain=.interbank.pe&doctype=01&auth=false',\n            type: 'POST',\n            dataType: 'jsonp'\n        }).always(function(a, textStatus, b) {\n            console.log('[Final status]: ', JSON.stringify(a), b, textStatus);\n            countDown = 0;\n        });\n    }\n  };\n  if ($btn.length === 1) {\n    $btn.attr('data-prevent-submit', true).off(\"click\");;\n    $form.one('ff-submit--before-ajax', beforeSubmit);\n  }\n});*/",language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RL5c000253187b4d8cbb2e73abcf14bf1b",name:"Web SDK - Productos Para Ti: View",events:[{modulePath:"data-layer-manager-search-discovery/src/lib/events/data_layer_push_event.js",settings:{eventType:"recommendation view",subscription:null},ruleOrder:50}],conditions:[],actions:[{modulePath:"adobe-alloy/dist/lib/actions/sendEvent/index.js",settings:{xdm:"%web.interaction.recommendationView.merged%",data:"%Freeform Data%",type:"web.webinteraction.linkClicks",instanceName:"alloy",edgeConfigOverrides:{development:{}}},timeout:2e3,delayNext:!0}]},{id:"RL60c580a16e69489ea4e343d94ff617be",name:"Checkbox LPDP Cuenta Simple",events:[{modulePath:"core/src/lib/events/pageBottom.js",settings:{},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"/solicitar/cuenta/simple/abrir-cuenta"}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:'try {\n  var href = window.location.href || "";\n  // Solo en la pantalla abrir-cuenta\n  if (href.indexOf("interbank.pe/solicitar/cuenta/simple/abrir-cuenta") === -1) {\n    return;\n  }\n\n  var CHECKBOX_ID = "checkboxOptionalPrivacyPolicy";\n  var STORAGE = window.sessionStorage; // cambia a localStorage si lo necesitas cross-tab\n  var KEY_CHECKED = "ibk_optin_optional_privacy_checked";\n  var KEY_TEXT = "ibk_optin_optional_privacy_text";\n\n  function normalizeText(s) {\n    return (s || "").replace(/\\s+/g, " ").trim();\n  }\n\n  function getLabelText() {\n    var label = document.querySelector(\'label[for="\' + CHECKBOX_ID + \'"]\');\n    // textContent incluye el texto del <a> tambi\xe9n\n    return label ? normalizeText(label.textContent) : "";\n  }\n\n  function attachListener() {\n    var cb = document.getElementById(CHECKBOX_ID);\n    if (!cb) return false;\n\n    // Guardar estado inicial (por si ya viene marcado)\n    STORAGE.setItem(KEY_CHECKED, String(!!cb.checked));\n    STORAGE.setItem(KEY_TEXT, getLabelText());\n\n    // Guardar en cada cambio (click/check/uncheck)\n    if (!cb.__ibkOptinBound) {\n      cb.addEventListener("change", function () {\n        STORAGE.setItem(KEY_CHECKED, String(!!cb.checked));\n        // Recalcula el texto por si cambia din\xe1micamente\n        STORAGE.setItem(KEY_TEXT, getLabelText());\n      });\n\n      // marca para evitar doble bind si la regla corre m\xe1s de una vez\n      cb.__ibkOptinBound = true;\n    }\n\n    return true;\n  }\n\n  // Intento inmediato\n  if (attachListener()) {\n    // ok\n  } else {\n    // Si es SPA o render tard\xedo, observar hasta que aparezca\n    var obs = new MutationObserver(function () {\n      if (attachListener()) obs.disconnect();\n    });\n    obs.observe(document.documentElement, { childList: true, subtree: true });\n\n    // Corte de seguridad: deja de observar despu\xe9s de 10s\n    setTimeout(function () { try { obs.disconnect(); } catch(e) {} }, 10000);\n  }\n\n} catch (e) {\n  // Evita romper la p\xe1gina si algo falla\n  // console.log("Optin listener error", e);\n}\n``',language:"javascript"},timeout:2e3,delayNext:!0},{modulePath:"adobe-alloy/dist/lib/actions/updateVariable/index.js",settings:{data:{_interbank:{event:{flow:{detail:"%Checkbox LPDP%"}}}},dataElementId:"DE4837f2551a834fe3b8105330a6ccf919"},timeout:2e3,delayNext:!0}]},{id:"RL63e2d2b853594848ac124d9e82795c6d",name:"Script - Pag Producto: Vehicular",events:[{modulePath:"core/src/lib/events/pageBottom.js",settings:{},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"/credito-vehicular",valueIsRegex:!1}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:'<script type="text/javascript"> var _rl_cn = _rl_cn || 0,_rl_ptc = ("https:" == window.location.protocol ? "https" : "http"); window._rl_ids = window._rl_ids || []; window._rely = window._rely || []; _rl_ids.push({pid:1028,src:0}); _rely.send = _rely.send?_rely.send:function() {}; (function() { var rl = document.createElement("script"); rl.type = "text/javascript"; rl.async = true; rl.src = _rl_ptc + "://api.retargetly.com/loader?id=" + _rl_ids[_rl_ids.length-1].pid; rl.id = "rely-api-"+(_rl_cn++); var s = document.getElementsByTagName("script")[0]; s.parentNode.insertBefore(rl, s); })(); </script>',language:"html"},timeout:2e3,delayNext:!0}]},{id:"RL65cb69d14395411c874a31132373cc8b",name:"Audience - Flujo de Ventas - Tarjetas de Cr\xe9dito",events:[{modulePath:"core/src/lib/events/pageBottom.js",settings:{},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"/solicitar/tarjeta/credito/inicio"}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:'var audience = _satellite.getVar("audience_tracking");\naudience("div[data-form-action=\'submit\']","#idni");\n\n',language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RL6c2d51a2555448149c403074a8cbfb15",name:"Web SDK - Search Click",events:[{modulePath:"core/src/lib/events/click.js",settings:{elementSelector:"#search-icon-id",bubbleFireIfParent:!0,bubbleFireIfChildFired:!0},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/pathAndQuerystring.js",settings:{paths:[{value:"/pequena-empresa"},{value:"/empresas-instituciones"},{value:"/106a6c241b8797f52e1e77317b96a201"}]},negate:!0,timeout:2e3}],actions:[{modulePath:"adobe-alloy/dist/lib/actions/sendEvent/index.js",settings:{xdm:"%web.interaction.tagSearchIcon.merged%",type:"web.webinteraction.linkClicks",instanceName:"alloy"},timeout:2e3,delayNext:!0}]},{id:"RL6cdc4bcd63f241e1965ab14ad0f0f4c0",name:"WarRoom - name_parameter",events:[{modulePath:"core/src/lib/events/libraryLoaded.js",settings:{},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/pathAndQuerystring.js",settings:{paths:[{value:"/promociones/mixta-1",valueIsRegex:!0},{value:"/promociones/mixta-2",valueIsRegex:!0},{value:"/promociones/mixta-3",valueIsRegex:!0},{value:"/promociones/mixta-4",valueIsRegex:!0}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"function getUrlParameter(name) {\n    name = name.replace(/[\\[]/, '\\\\[').replace(/[\\]]/, '\\\\]');\n    var regex = new RegExp('[\\\\?&]' + name + '=([^&#]*)');\n    var results = regex.exec(location.search);\n    return results === null ? '' : decodeURIComponent(results[1].replace(/\\+/g, ' '));\n}\n\nvar element = document.getElementById(\"wroomName\");\nvar wroomName = getUrlParameter('name');\n\nif(element && wroomName){\n    element.innerHTML = 'Hola ' + wroomName;\n    console.log('change!!');\n}\n",language:"javascript"},timeout:2e3,delayNext:!0}]},{id:"RL6e43934e9c384b07b522b4f89f0dc3d7",name:"Web SDK - Custom Link",events:[{modulePath:"data-layer-manager-search-discovery/src/lib/events/data_layer_push_event.js",settings:{eventType:"sendCustomLink",subscription:null},ruleOrder:50}],conditions:[],actions:[{modulePath:"adobe-alloy/dist/lib/actions/sendEvent/index.js",settings:{xdm:"%web.interaction.merged%",data:"%Freeform Data%",type:"web.webinteraction.linkClicks",instanceName:"alloy",edgeConfigOverrides:{development:{}}},timeout:2e3,delayNext:!0}]},{id:"RL712d40c22f8a47668dbdd08f7440a96e",name:"Bypass Hub Cliente - TC 2.0",events:[{modulePath:"core/src/lib/events/domReady.js",settings:{},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/path.js",settings:{paths:[{value:"/solicitar/tarjeta/credito/seleccionar-tarjeta"}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"https://assets.adobedtm.com/df637a308f4c/d9eb0acc4ee2/0b48f5f8e516/RC5b40de3430864770b84e4b805c947955-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0}]},{id:"RL71838a91f4c84d8f87e4fd6b2b60bcbe",name:"Audience - PP | IL | EXTRACASH - API  ",events:[{modulePath:"core/src/lib/events/domReady.js",settings:{},ruleOrder:50}],conditions:[{modulePath:"core/src/lib/conditions/pathAndQuerystring.js",settings:{paths:[{value:"/solicitar/tarjeta/extracash/no-campana-c"},{value:"/solicitar/tarjeta/incremento-de-linea/sin-campania"}]},timeout:2e3}],actions:[{modulePath:"core/src/lib/actions/customCode.js",settings:{source:"https://assets.adobedtm.com/df637a308f4c/d9eb0acc4ee2/0b48f5f8e516/RC8ca126be4fbd40d58643fe5aa80419b6-source.min.js",language:"javascript",isExternal:!0},timeout:2e3,delayNext:!0}]},{id:"RL734e505ff0de4a9fb470a61120d522ae",name:"Web SDK - Productos Para Ti: Timeout",events